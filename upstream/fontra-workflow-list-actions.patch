--- /dev/null
+++ b/test-py/test_workflow_command.py
@@ -0,0 +1,54 @@
+import json
+import subprocess
+import sys
+
+from fontra.workflow.command import formatActionInfos, getActionInfos
+
+
+def test_getActionInfos():
+    infos = getActionInfos()
+    byName = {(info["type"], info["name"]): info for info in infos}
+
+    assert ("input", "fontra-read") in byName
+    assert ("output", "fontra-write") in byName
+
+    scale = byName["filter", "scale"]
+    assert scale["module"] == "fontra.workflow.actions.glyph"
+    assert scale["arguments"] == [
+        {"name": "scaleFactor", "type": "float", "required": True},
+        {"name": "scaleFontMetrics", "type": "bool", "default": True},
+        {"name": "scaleKerning", "type": "bool", "default": True},
+    ]
+
+    # Fields the engine sets are not arguments
+    fontraWrite = byName["output", "fontra-write"]
+    assert [a["name"] for a in fontraWrite["arguments"]] == ["destination"]
+
+    # Defaults are plain JSON: a set default becomes a list, an enum its value
+    subset = byName["filter", "subset-glyphs"]
+    arguments = {a["name"]: a for a in subset["arguments"]}
+    assert arguments["glyphNames"]["default"] == []
+    assert arguments["layoutHandling"]["default"] == "subset"
+
+    json.dumps(infos)  # all of it is JSON
+
+
+def test_formatActionInfos():
+    text = formatActionInfos(getActionInfos())
+    assert text.startswith(
+        "input actions:\n  fontra-read\n    source: str (required)\n"
+    )
+    assert "\n  scale\n    scaleFactor: float (required)\n" in text
+    assert "    scaleKerning: bool = true\n" in text
+
+
+def test_list_actions_command():
+    result = subprocess.run(
+        [sys.executable, "-m", "fontra.workflow.command", "list-actions", "--json"],
+        capture_output=True,
+        encoding="utf-8",
+        check=True,
+    )
+    infos = json.loads(result.stdout)
+    assert {"type", "name", "module", "arguments"} == set(infos[0])
+    assert any(info["name"] == "subset-glyphs" for info in infos)
